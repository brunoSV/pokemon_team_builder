<h1>Types</h1>

<%= link_to "New type", new_admin_type_path, class: "btn btn-primary" %>

<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Name</th><th></th></tr>
    </thead>
    <tbody>
      <% @types.each do |type| %>
        <tr>
          <td><%= type.name %></td>
          <td>
            <%= link_to "Edit", edit_admin_type_path(type), class: "btn" %>
            <%= button_to "Delete", admin_type_path(type), method: :delete, class: "btn btn-danger", form: { style: "display:inline" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
