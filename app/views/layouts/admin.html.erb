<!DOCTYPE html>
<html>
  <head>
    <title>Pokemon Team Builder Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      body { font-family: sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
      nav { margin-bottom: 1.5rem; }
      nav a { margin-right: 1rem; }
      table { border-collapse: collapse; width: 100%; }
      th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid #ddd; }
      .notice { color: green; }
      .alert { color: crimson; }
      form > div { margin-bottom: 0.75rem; }
      label { display: block; font-weight: bold; }
    </style>
  </head>
  <body>
    <nav>
      <%= link_to "Pokemon", admin_pokemons_path %>
      <%= link_to "Types", admin_types_path %>
      <%= link_to "Attacks", admin_attacks_path %>
      <%= link_to "Type effectiveness", admin_type_effectivenesses_path %>
      <%= button_to "Log out", destroy_admin_user_session_path, method: :delete, form: { style: "display:inline" } %>
    </nav>

    <p class="notice"><%= notice %></p>
    <p class="alert"><%= alert %></p>

    <%= yield %>
  </body>
</html>
