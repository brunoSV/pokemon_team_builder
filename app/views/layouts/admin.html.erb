<!DOCTYPE html>
<html>
  <head>
    <title>Pokemon Team Builder Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      /* Ported from the trainer frontend's src/index.css so the admin panel
         shares the same tokens, type scale, and component look. */
      :root {
        --text: #6b6375;
        --text-h: #08060d;
        --bg: #fff;
        --border: #e5e4e7;
        --code-bg: #f4f3ec;
        --accent: #aa3bff;
        --accent-bg: rgba(170, 59, 255, 0.1);
        --accent-border: rgba(170, 59, 255, 0.5);
        --danger: #d33;
        --danger-bg: rgba(221, 51, 51, 0.1);
        --danger-border: rgba(221, 51, 51, 0.5);

        --sans: system-ui, 'Segoe UI', Roboto, sans-serif;
        --mono: ui-monospace, Consolas, monospace;

        font: 16px/145% var(--sans);
        color-scheme: light dark;
        color: var(--text);
        background: var(--bg);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --text: #9ca3af;
          --text-h: #f3f4f6;
          --bg: #16171d;
          --border: #2e303a;
          --code-bg: #1f2028;
          --accent: #c084fc;
          --accent-bg: rgba(192, 132, 252, 0.15);
          --accent-border: rgba(192, 132, 252, 0.5);
          --danger: #f47171;
          --danger-bg: rgba(244, 113, 113, 0.15);
          --danger-border: rgba(244, 113, 113, 0.5);
        }
      }

      * { box-sizing: border-box; }

      body { margin: 0; }

      .container {
        max-width: 1000px;
        width: 100%;
        margin: 0 auto;
        padding: 24px 16px 64px;
      }

      h1, h2 {
        font-family: var(--sans);
        font-weight: 600;
        color: var(--text-h);
      }

      h1 { font-size: 28px; margin: 0 0 20px; }
      h2 { font-size: 20px; margin: 0 0 12px; }

      .nav {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 16px 24px;
        border-bottom: 1px solid var(--border);
      }

      .nav a {
        color: var(--text);
        text-decoration: none;
        font: inherit;
      }

      .nav a:hover { color: var(--text-h); }

      .nav-spacer { flex: 1; }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        padding: 6px 14px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--text-h);
        cursor: pointer;
        font: inherit;
        text-decoration: none;
      }

      .btn-primary {
        border-color: var(--accent-border);
        background: var(--accent-bg);
      }

      .btn-danger {
        border-color: var(--danger-border);
        background: var(--danger-bg);
        color: var(--danger);
      }

      .nav .btn { padding: 6px 12px; }

      /* Notices */
      .notice, .alert {
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 14px;
        margin: 16px 0;
      }

      .notice:empty, .alert:empty { display: none; margin: 0; }

      .notice {
        background: var(--accent-bg);
        border: 1px solid var(--accent-border);
        color: var(--text-h);
      }

      .alert {
        background: var(--danger-bg);
        border: 1px solid var(--danger-border);
        color: var(--danger);
      }

      /* Tables */
      .table-wrap {
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
        margin-top: 16px;
      }

      table { border-collapse: collapse; width: 100%; }

      th {
        text-align: left;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text);
        background: var(--code-bg);
        padding: 10px 14px;
      }

      td {
        padding: 10px 14px;
        border-top: 1px solid var(--border);
        color: var(--text-h);
      }

      tbody tr:hover { background: var(--code-bg); }

      td .btn, td form { display: inline-block; }
      td form + .btn, td .btn + form { margin-left: 8px; }

      /* Forms */
      form.admin-form {
        display: flex;
        flex-direction: column;
        gap: 14px;
        max-width: 420px;
        margin-top: 16px;
      }

      form.admin-form > div {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      form.admin-form label {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-h);
      }

      form.admin-form input:not([type="submit"]),
      form.admin-form select {
        padding: 8px 10px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--text-h);
        font: inherit;
      }

      form.admin-form .btn {
        align-self: flex-start;
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <%= link_to "Pokemon", admin_pokemons_path %>
      <%= link_to "Types", admin_types_path %>
      <%= link_to "Attacks", admin_attacks_path %>
      <%= link_to "Type effectiveness", admin_type_effectivenesses_path %>
      <span class="nav-spacer"></span>
      <%= button_to "Log out", destroy_admin_user_session_path, method: :delete, class: "btn", form: { style: "display:inline" } %>
    </nav>

    <div class="container">
      <p class="notice"><%= notice %></p>
      <p class="alert"><%= alert %></p>

      <%= yield %>
    </div>
  </body>
</html>
